	(gr_text "Leiterbahn: Empfohlen: 0.5 mm - 1.0 mm Breite für die 400V-Leitungen. \n	Vermeide scharfe Ecken (runde oder abgeschrägte Ecken sind besser).\nBauteile: 1210 für R & C (wegen Spannungsfestigkeit), SMA-Diode (1000V).\nAbstände (Clearance): 1.5 - 2.0 mm zwischen allen 400V-Leitern und zu GND.\nKeine {dblquote}Backplane{dblquote} mit GND"
		(at 93.1 56.5 0)
		(layer "User.2")
		(uuid "18d27890-fce6-4dca-bd7f-947081cee045")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
			(justify left bottom)
		)
	)
